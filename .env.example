# Sao chép thành .env rồi điền. Lưu bằng UTF-8 (Notepad mặc định thêm BOM — code đã xử lý).

# --- Tầng A: bóc BCTC (chạy trên máy tính) ---
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-opus-5
LOCATE_MODEL=claude-haiku-4-5

# --- Tầng B: thông báo đẩy (dùng trong GitHub Actions, đặt vào Secrets; local chỉ để thử) ---
# Sinh bằng: python -m job.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cloudflare Worker (nhận đăng ký + cài đặt) ---
WORKER_URL=
WORKER_TOKEN=
# Dự phòng khi Worker không trả lời: JSON mảng subscription
PUSH_SUBS_FALLBACK=

# --- Chung ---
HTTP_TIMEOUT=30
